{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upgradr-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  // See the matching note in apps/mcp-worker/wrangler.jsonc: the ports are
  // pinned so both dev servers can run at the same time. 8787 must match
  // APP_ORIGIN, which is where Supabase redirects for the consent screen.
  "dev": {
    "port": 8787,
    "inspector_port": 9229
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8787"
  },
  // Throttles POST /api/auth/verify-otp (see worker/index.ts and env.ts's
  // comment on OTP_VERIFY_RATE_LIMITER for why this exists). "ratelimits"
  // is not inherited into named environments (see wrangler's own schema
  // note), so this is repeated under env.production below -- keep both in
  // sync if the limit ever changes. namespace_id just needs to be a unique
  // id within this account; it isn't secret.
  "ratelimits": [
    {
      "name": "OTP_VERIFY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Deploy with `wrangler deploy --env production`. `name` is repeated here
  // (unchanged) so Wrangler does not append "-production" to the deployed
  // Worker's name/URL. Every REPLACE_ME below will fail loud (a build/deploy
  // that visibly errors, or `check:deployment` reporting a bad value) rather
  // than silently shipping a localhost/example value to production --
  // replace with real values once the Supabase project and Cloudflare
  // account/subdomain exist (see plan.md, "Deploying to production").
  // SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY are not secret (publishable key is
  // safe to commit); SUPABASE_SERVICE_ROLE_KEY is set separately via
  // `wrangler secret put`, never as a plain var.
  "env": {
    "production": {
      "name": "upgradr-web",
      // Provisions the custom domain (and its TLS cert) on deploy, so the
      // hostname is versioned here rather than set by hand in the
      // Cloudflare dashboard. Must stay identical to APP_ORIGIN below and
      // to Supabase's Site URL / Redirect URL allow-list -- see
      // docs/deployment.md, "A one-character typo in the Redirect URL
      // allow-list breaks sign-in silently".
      "routes": [{ "pattern": "upgradr.app", "custom_domain": true }],
      // Keeps the Free-plan Supabase project from being paused for
      // inactivity -- see worker/keepalive.ts for why the cadence is a few
      // times a day rather than once every few days. Declared here rather
      // than at the top level so the cron only exists in production; a
      // second, unattended copy of this schedule is not wanted anywhere
      // else. Times are UTC.
      "triggers": { "crons": ["0 6 * * *", "0 14 * * *", "0 22 * * *"] },
      "vars": {
        "APP_ORIGIN": "https://upgradr.app",
        "SUPABASE_URL": "https://yshjthrciysbvzddvfgf.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_VCw1z6v1S7nwNCL77cuCRA_077NaQfC"
      },
      "ratelimits": [
        {
          "name": "OTP_VERIFY_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}
