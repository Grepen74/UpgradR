{
  "name": "upgradr",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:web": "npm run dev --workspace @upgradr/web",
    "dev:mcp": "npm run dev --workspace @upgradr/mcp-worker",
    "mcp:login": "node scripts/mcp-agent-login.mjs",
    "mcp:tools-doc": "node scripts/generate-mcp-tools-doc.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "check:mcp-local": "node scripts/mcp-local-e2e.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:login": "node scripts/demo-login.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}

